# Application
APP_NAME=meta-chatbot-backend
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=*

# SQLite (WAL mode is enabled in the engine). Docker uses sqlite:////data/app.db
DATABASE_URL=sqlite:///./data/app.db

# Google Gemini (Google AI Studio / free tier)
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.6-flash

# Meta (WhatsApp Cloud API + Instagram Graph API)
META_ACCESS_TOKEN=your-meta-access-token
META_VERIFY_TOKEN=change-me-webhook-verify-token
META_GRAPH_API_BASE=https://graph.facebook.com
META_GRAPH_API_VERSION=v21.0
PHONE_NUMBER_ID=your-whatsapp-phone-number-id
INSTAGRAM_ACCOUNT_ID=your-instagram-account-id

# Optional: override the default FAQ / handoff system instruction
# BOT_SYSTEM_INSTRUCTION=
